PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Set to the actual storefront origins when hosting the frontend separately.
STOREFRONT_ORIGINS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
